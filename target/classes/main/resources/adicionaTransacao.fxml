<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<BorderPane prefHeight="550.0" prefWidth="600.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fintrack.controller.AdicionaTransacaoController">

    <!-- Cabeçalho Laranja -->
    <top>
        <VBox alignment="CENTER_LEFT" spacing="5.0" styleClass="header-pane" BorderPane.alignment="CENTER">
            <children>
                <Text styleClass="header-title" text="FinTrack" />
                <Text styleClass="header-subtitle" text="Cadastrar Nova Transação" />
            </children>
        </VBox>
    </top>

    <!-- Formulário Central -->
    <center>
        <VBox alignment="TOP_CENTER" spacing="20.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
            </padding>
            <children>
                <VBox maxWidth="500.0" spacing="15.0" styleClass="menu-card">
                    <children>
                        <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #E65100;" text="Preencha os dados da transação" />

                        <!-- Descrição -->
                        <VBox spacing="5.0">
                            <children>
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #424242;" text="Descrição" />
                                <TextField fx:id="txtDescricao" promptText="Ex: Salário, Mercado, Luz..." />
                            </children>
                        </VBox>

                        <!-- Valor -->
                        <VBox spacing="5.0">
                            <children>
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #424242;" text="Valor (R$)" />
                                <TextField fx:id="txtValor" promptText="Ex: 150.50" />
                            </children>
                        </VBox>

                        <!-- Tipo de Transação -->
                        <VBox spacing="5.0">
                            <children>
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #424242;" text="Tipo de Transação" />
                                <ComboBox fx:id="comboTipo" maxWidth="1.7976931348623157E308" promptText="Selecione o Tipo" />
                            </children>
                        </VBox>

                        <!-- Data -->
                        <VBox spacing="5.0">
                            <children>
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #424242;" text="Data" />
                                <DatePicker fx:id="dpData" maxWidth="1.7976931348623157E308" promptText="Selecione a Data" />
                            </children>
                        </VBox>

                        <!-- Botões de Ação -->
                        <HBox alignment="CENTER_RIGHT" spacing="12.0">
                            <padding>
                                <Insets top="10.0" />
                            </padding>
                            <children>
                                <Button onAction="#voltarParaMain" styleClass="button-orange-soft" text="Cancelar" />
                                <Button onAction="#salvarTransacao" styleClass="button-orange" text="💾 Salvar Transação" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </center>
</BorderPane>
